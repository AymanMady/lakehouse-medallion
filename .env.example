# =============================================================================
#  Lakehouse Medallion — Configuration
# =============================================================================
#  Copy this file to `.env` and adjust.  NEVER commit `.env`.
#     cp .env.example .env     (or:  make init)
# =============================================================================

# ----------------------------- General ---------------------------------------
TZ=Europe/Paris

# Containers that WRITE into bind-mounted project folders (dbt, datagen) run as
# this uid/gid, otherwise files they create are unwritable from the host.
# `make init` fills these in with your own `id -u` / `id -g`.
HOST_UID=1000
HOST_GID=1000

# Which optional service groups Docker Compose starts.
#   (core = minio, postgres, kafka, kafka-ui : always started)
#   spark   -> spark-master, spark-worker, spark-thrift
#   airflow -> airflow-init, airflow-scheduler, airflow-webserver
#   dbt     -> dbt (idle container, used via `docker compose exec`)
#   tools   -> datagen (data generator / Kafka producer)
# Trim this list if you are short on RAM (full stack ~ 8 GB).
COMPOSE_PROFILES=spark,airflow,dbt,tools

# ------------------------- MinIO / S3 storage --------------------------------
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
# MinIO images are published on quay.io (no longer on Docker Hub).
# This release is the last one shipping the full web console.
MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z
MC_VERSION=RELEASE.2025-05-21T01-59-54Z

# S3A / boto3 credentials. They MUST mirror the MinIO root credentials above.
S3_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=lakehouse
AWS_SECRET_ACCESS_KEY=CHANGE_ME_minio_password
AWS_REGION=us-east-1
LAKEHOUSE_BUCKET=lakehouse

# ----------------------------- PostgreSQL ------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=15432
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=lakehouse
# Extra databases created at first boot (comma separated, no spaces)
POSTGRES_MULTIPLE_DATABASES=airflow,metastore,analytics
# Database backing the Hive Metastore used by Spark + dbt
METASTORE_DB=metastore

# ------------------------------- Kafka ---------------------------------------
KAFKA_VERSION=3.9.0
# Base64 UUID (22 chars) identifying the KRaft cluster. Keep it stable.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
# Inside the Docker network
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# From your laptop (host)
KAFKA_EXTERNAL_PORT=29092
KAFKA_UI_PORT=18085

# ------------------------------- Spark ---------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_MASTER_UI_PORT=18081
SPARK_WORKER_UI_PORT=18082
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=4G
SPARK_THRIFT_PORT=10000
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g

# ------------------------------ Airflow --------------------------------------
# Must equal your host UID so Airflow can write ./airflow/logs  ->  run: id -u
AIRFLOW_UID=50000
AIRFLOW_WEB_PORT=18088
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_airflow_password
# Generate with:  openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=CHANGE_ME_airflow_secret

# --------------------------- Data generator ----------------------------------
GEN_NUM_CUSTOMERS=5000
GEN_NUM_PRODUCTS=800
GEN_NUM_ORDERS=50000
GEN_SEED=42
# Share of intentionally dirty records (so the Silver layer has real work)
GEN_NULL_RATE=0.03
GEN_DUPLICATE_RATE=0.02
GEN_INVALID_RATE=0.02

# Absolute path of this project ON THE HOST (Airflow DockerOperator mounts)
# Generated by scripts/bootstrap_env.sh; must be an absolute HOST path.
LAKEHOUSE_HOST_DIR=/absolute/path/to/lakehouse-medallion
